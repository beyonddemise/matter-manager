{
  "$schema": "https://raw.githubusercontent.com/lit/lit/main/packages/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": ["de"],
  "inputFiles": ["packages/web/src/**/*.ts"],
  "output": {
    "mode": "runtime",
    "language": "ts",
    "outputDir": "packages/web/src/generated/locales",
    "localeCodesModule": "packages/web/src/generated/locale-codes.ts"
  },
  "interchange": {
    "format": "xliff",
    "xliffDir": "packages/web/xliff/"
  }
}
