# Dependencies
node_modules/
.npm/

# Build output
dist/
build/
*.tsbuildinfo
.vite/

# Test output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
!infra/couchdb/**/*.key

# Local data
.couchdb-data/
*.local

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Subagent-driven-development scratch workspace
.superpowers/

# Browser-test artefacts
packages/web/.vitest-attachments/
# Anchored with ** because vitest writes these beside each test file, not only at the
# top of test/: a plain `test/__screenshots__/` misses test/<area>/__screenshots__/ and a
# failure screenshot then arrives in a commit looking like a deliberate baseline.
packages/web/test/**/__screenshots__/

# Written and removed by scripts/check-i18n.mjs; listed so a crashed run leaves no trap.
.lit-localize.check.json

# Screenshots and snapshots from the Playwright MCP browser, used for manual verification.
.playwright-mcp/
