{
  "$schema": "https://raw.githubusercontent.com/lit/lit/main/packages/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": ["de"],
  "inputFiles": ["src/ui/**/*.ts"],
  "output": {
    "mode": "runtime",
    "language": "ts",
    "outputDir": "src/ui/generated/locales",
    "localeCodesModule": "src/ui/generated/locale-codes.ts"
  },
  "interchange": {
    "format": "xliff",
    "xliffDir": "xliff/"
  }
}
