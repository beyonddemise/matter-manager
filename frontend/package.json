{
  "name": "@matter-manager/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The browser application: Matter codec, offline catalogue and Lit SPA. Installs and tests on its own.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.domain.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:webawesome": "node scripts/check-webawesome-pro.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:deploy": "node scripts/check-deploy-headers.mjs",
    "check:graph": "node scripts/check-module-graph.mjs",
    "check:lazy": "node scripts/check-lazy-fallback.mjs",
    "check:offline": "node scripts/check-offline-assets.mjs",
    "i18n:extract": "lit-localize extract",
    "i18n:build": "lit-localize build",
    "i18n": "npm run i18n:extract && npm run i18n:build",
    "assets:fetch": "node scripts/fetch-offline-assets.mjs",
    "probe:runtime": "node scripts/probe-runtime-requests.mjs",
    "probe:svg": "node scripts/probe-svg-rendering.mjs",
    "verify": "npm run check:webawesome && npm run check:i18n && npm run check:deploy && npm run check:graph && npm run check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@awesome.me/webawesome-pro": "^3.12.0",
    "@lit/localize": "^0.12.2",
    "@zxing/browser": "^0.2.1",
    "events": "^3.3.0",
    "lit": "^3.3.3",
    "pdf-lib": "^1.17.1",
    "pouchdb-browser": "^9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@lit/localize-tools": "^0.8.2",
    "@open-wc/testing-helpers": "^3.0.1",
    "@types/node": "^24.13.4",
    "@types/pouchdb-adapter-memory": "^6.1.6",
    "@types/pouchdb-browser": "^6.1.5",
    "@types/pouchdb-core": "^7.0.15",
    "@types/pouchdb-replication": "^6.4.7",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "playwright": "^1.62.1",
    "pouchdb-adapter-memory": "^9.0.0",
    "pouchdb-core": "^9.0.0",
    "pouchdb-replication": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
