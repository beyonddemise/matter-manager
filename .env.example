# ---------------------------------------------------------------------------
# Matter Manager - copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- CouchDB (local devcontainer defaults; override in production) ---
COUCHDB_URL=http://localhost:5984
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=devonly-change-me

# --- API server ---
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173

# --- Google OIDC (M4) ---
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT signing (M4) ---
# RS256 keypair. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -pubout -in jwt-private.pem -out jwt-public.pem
# CouchDB is configured with the PUBLIC key only, so it can validate without the API.
JWT_PRIVATE_KEY_PATH=./jwt-private.pem
JWT_PUBLIC_KEY_PATH=./jwt-public.pem
JWT_ISSUER=matter-manager
JWT_AUDIENCE=matter-manager
JWT_TTL_SECONDS=3600
