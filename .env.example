# ---------------------------------------------------------------------------
# Matter Manager - copy to .env and fill in. NEVER commit .env.
#
# Every variable here is read by something. If you add one, add the code that
# reads it in the same change: a documented variable that nothing reads is
# worse than an undocumented one, because it looks configured.
# ---------------------------------------------------------------------------

# --- Web Awesome Pro (required before `npm ci` will work) ---
# @awesome.me/webawesome-pro is published only to https://npm.webawesome.com/
# and is NOT on public npm. .npmrc reads this variable; without it `npm ci` fails.
#
# Export it in your shell profile rather than putting it here, so that plain
# `npm ci`, the devcontainer and your editor all see it:
#   export WEBAWESOME_NPM_TOKEN=...
#
# In CI it is the repository secret of the same name.
WEBAWESOME_NPM_TOKEN=

# --- CouchDB ---
# Port 5985, not CouchDB's default 5984, so the development stack cannot collide
# with another CouchDB already running on the machine. Inside the compose network
# the port is still 5984, so the app container uses http://couchdb:5984.
#
# All three are needed together. Without them the API serves /healthz and nothing
# else - no projects, no sign-in - rather than serving routes that fail at the
# moment somebody presses the button.
COUCHDB_URL=http://localhost:5985
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=devonly-change-me

# --- API server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Where the browser is returned to after signing in, and the one origin allowed
# to make cross-origin requests. Nothing configured means NO cross-origin access,
# so a deployment that forgets this refuses the application rather than admitting
# the internet. A trailing slash is trimmed; a path or a wildcard stops startup.
APP_ORIGIN=http://localhost:5173

# Only for a second front end - a staging deployment, another domain. APP_ORIGIN
# is included automatically. Comma-separated.
#CORS_ORIGINS=

# `true` when the API runs behind a proxy that sets X-Forwarded-For (Caddy, in
# infra/compose.prod.yml). This matters in BOTH directions: unset behind a proxy,
# every request looks like it comes from the proxy, one address is counted for
# everybody, and the first twenty sign-in attempts from anywhere lock out the
# world; set where there is no trusted proxy, any client can claim any address
# and the rate limit is off.
TRUST_PROXY=false

# Where the CouchDB design documents live. Normally found by walking up from the
# installed package, so this is only needed when that fails - a bundled build, an
# unusual container layout.
#DESIGN_DOCS_DIR=

# --- Google sign-in ---
# Full walkthrough, with the console URLs: docs/GOOGLE-SIGN-IN.md
#
# Create the client at https://console.cloud.google.com/auth/clients
# (Application type: Web application). All three are needed together; with any
# one missing the API serves no /auth routes at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a redirect URI registered in the console BYTE FOR BYTE - scheme,
# host, port, path, trailing slash. The path is fixed by the service; only the
# host in front of it is yours to choose. `http` is refused except on localhost.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- JWT signing ---
# ES256 on an EC P-256 key. NOT RSA: CouchDB is configured to validate ES256, and
# an RSA key here would start a service whose every token CouchDB then refuses,
# which presents as "sign-in works, nothing else does". A non-EC key stops
# startup rather than reaching that state.
#
#   openssl ecparam -name prime256v1 -genkey -noout -out jwt-private.pem
#
# The PEM itself, not a path to it. Multi-line values work in a .env file when
# double-quoted (Compose v2 and later); in a shell, use:
#
#   export JWT_PRIVATE_KEY="$(cat jwt-private.pem)"
#
# The PUBLIC half is pushed into CouchDB's [jwt_keys] at startup by auth/keys.ts,
# so key material never enters an image and rotation needs no rebuild. That also
# means ANYTHING signed with this key is a database credential - which is why the
# session cookie gets its own key below.
JWT_PRIVATE_KEY=

# A SECOND key, generated exactly the same way and DIFFERENT from the one above.
# It signs the session cookie and the PKCE carrier, and its public half is never
# given to CouchDB.
#
# CouchDB validates these tokens itself, checking a signature and an expiry and
# evaluating no claim this service invented. So a thirty-day session signed with
# JWT_PRIVATE_KEY would be a thirty-day direct database credential no matter how
# carefully the API refused to accept one as a bearer. A key CouchDB has never
# been given cannot be verified there at all.
#
# There is no fallback: without this, the API serves no sign-in and no profile.
JWT_SESSION_PRIVATE_KEY=

# Names the key in every token header and in CouchDB's [jwt_keys]. A date is the
# convention, because rotation means adding the next one beside this one.
JWT_KEY_ID=ec-2026-08
